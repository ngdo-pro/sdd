{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/nanko/spec-framework/schemas/config.schema.json",
  "title": "Spec Framework configuration",
  "description": "Configuration for the `spec` CLI (.specs/config.json).",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "sourceOfTruth": {
      "type": "string",
      "default": "filesystem",
      "description": "Backend id read from during resolution. Must reference an enabled backend."
    },
    "backends": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "description": "Unique backend identifier (also used as the remote-map key)." },
          "type": { "type": "string", "description": "Backend implementation, e.g. filesystem, linear, or an extensions/<id> folder." },
          "enabled": { "type": "boolean", "default": false },
          "required": { "type": "boolean", "default": false, "description": "Required backends cannot be disabled." },
          "settings": { "type": "object", "additionalProperties": true }
        }
      },
      "default": [
        { "id": "filesystem", "type": "filesystem", "enabled": true, "required": true },
        { "id": "linear", "type": "linear", "enabled": false }
      ]
    }
  }
}
