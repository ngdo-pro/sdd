{
  "id": "linear",
  "name": "Linear Issues",
  "version": "1.0.0",
  "type": "linear",
  "kind": "remote",
  "builtin": true,
  "entry": "../../src/backends/linear.js",
  "description": "Mirrors framework artifacts onto Linear issues (GraphQL API). This backend is built into the CLI and documented here.",
  "capabilities": ["read", "list", "transition", "create"],
  "authentication": {
    "env": "LINEAR_API_KEY",
    "setting": "settings.apiKey"
  },
  "settings": {
    "teamKey": "",
    "stateMap": { "planned": "Backlog", "active": "In Progress", "archived": "Done" },
    "labels": { "initiative": "initiative", "feature": "feature", "spec": "spec" },
    "createOnMove": false
  }
}
