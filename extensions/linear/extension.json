{
  "id": "linear",
  "name": "Linear Issues",
  "version": "2.0.0",
  "type": "linear",
  "kind": "mirror",
  "builtin": true,
  "entry": "../../src/backends/linear.js",
  "description": "Mirrors canonical model artifacts onto Linear issues (GraphQL API). Built into the CLI and documented here.",
  "capabilities": ["read", "list", "transition", "create"],
  "authentication": {
    "env": "LINEAR_API_KEY",
    "setting": "settings.apiKey"
  },
  "remoteRefs": "artifact.remote.linear (stored in .sdd/canonical/**/<artifact>.json)",
  "settings": {
    "teamKey": "",
    "stateMap": { "planned": "Backlog", "active": "In Progress", "archived": "Done" },
    "labels": { "initiative": "initiative", "feature": "feature", "spec": "spec" },
    "createOnMove": false
  }
}

