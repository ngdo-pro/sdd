{
  "id": "linear",
  "name": "Linear Issues",
  "version": "2.0.0",
  "type": "linear",
  "kind": "mirror",
  "builtin": true,
  "entry": "../../src/connectors/linear.js",
  "description": "Mirrors canonical model artifacts onto Linear issues through the Linear MCP server (JSON-RPC stdio or HTTP). Built into the CLI and documented here.",
  "capabilities": ["read", "list", "transition", "create"],
  "remoteRefs": "artifact.remote.linear (stored in .sdd/canonical/**/<artifact>.json)",
  "settings": {
    "teamKey": "",
    "stateMap": { "planned": "Backlog", "active": "In Progress", "archived": "Done" },
    "labels": { "initiative": "initiative", "feature": "feature", "spec": "spec" },
    "createOnMove": false,
    "mcp": {}
  },
  "settingTypes": {
    "teamKey": "string",
    "stateMap": "object",
    "labels": "object",
    "createOnMove": "boolean",
    "mcp": "object"
  },
  "requiredSettings": ["teamKey", "mcp"]
}